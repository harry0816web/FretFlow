POSTGRES_DB=fretflow
POSTGRES_USER=fretflow
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql+psycopg://fretflow:change-me-for-local-development@db:5432/fretflow
INFERENCE_MODE=fixture
FRETFLOW_ARTIFACT_ROOT=/var/lib/fretflow/artifacts
FRETFLOW_FIXTURE_DIR=/fixtures
FRETFLOW_LOCAL_OWNER_ID=local-user
# inline: the API runs jobs itself (fixture). queue: a worker claims them.
# ./fretflow.sh up sets this for you.
# FRETFLOW_JOB_EXECUTION=inline
# Worker overrides (auto picks CUDA, then MPS, then CPU):
# FRETFLOW_DEVICE=auto
# FRETFLOW_MVSEP_PYTHON=.venv-mvsep/bin/python
# FRETFLOW_MODEL_DIR=/opt/fretflow/models/mvsep_mega
# FRETFLOW_MVSEP_SCRIPT=/app/infer_mvsep_mega.py
# FRETFLOW_SKIP_MODEL_CHECKSUM=true
